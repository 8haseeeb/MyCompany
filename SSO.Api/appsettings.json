{
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173", "http://localhost:5001", "http://127.0.0.1:5001", "http://[::1]:5001", "http://localhost:5089", "https://localhost:7211"]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=sqlserver,1433;Database=SSOIdentityDb;User Id=sa;Password=MyPass@123;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=true",
    "Redis": ""
  },
  "JwtSettings": {
    "Secret": "REPLACE_VIA_ENV_OR_USER_SECRETS",
    "Issuer": "MyCompany",
    "Audience": "MyCompanyUsers",
    "ExpiryMinutes": 60
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/sso-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "SSO.Api"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  },
  "AllowedHosts": "*",
  "ApplicationInsights": {
    "ConnectionString": ""
  }
}
