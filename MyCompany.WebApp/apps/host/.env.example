# API base URL. Leave empty when using Vite dev server proxy (proxy target in vite.config.js).
# For production build, set to your gateway URL, e.g.:
# VITE_API_BASE_URL=https://api-gateway.your-domain.com
VITE_API_BASE_URL=

# Application Insights (optional). Set in production for frontend telemetry.
# VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...;...
VITE_APPINSIGHTS_CONNECTION_STRING=
