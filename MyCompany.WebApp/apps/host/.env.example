# Gateway URL: browser calls this for API (CORS must allow http://localhost:5001).
# Docker Compose publishes the gateway at http://localhost:5089 (see repo docker-compose.yml).
VITE_API_BASE_URL=http://localhost:5089

# Promotions MFE: Vite preview only (default 5002). NEVER set this to the API gateway (:5089).
# VITE_PROMOTIONS_PREVIEW_TARGET=http://127.0.0.1:5002
#
# Optional: override federation remote origin in dev (still must be the MFE preview port, not :5089).
# VITE_PROMOTIONS_MFE_ORIGIN=http://localhost:5002

# Application Insights (optional). Set in production for frontend telemetry.
# VITE_APPINSIGHTS_CONNECTION_STRING=InstrumentationKey=...;IngestionEndpoint=...;...
VITE_APPINSIGHTS_CONNECTION_STRING=
