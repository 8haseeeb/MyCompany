{
  "name": "mycompany-webapp-root",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:host": "npm run dev --workspace=apps/host",
    "dev:promotions": "npm run dev --workspace=apps/promotions",
    "dev": "concurrently \"npm run dev:host\" \"npm run dev:promotions\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "vite": "^5.4.11"
  }
}